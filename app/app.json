{
  "expo": {
    "name": "MyReels",
    "slug": "myreels",
    "scheme": "myreels",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.yourname.myreels"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      ["expo-media-library", { "savePhotosPermission": "Allow saving your videos to the gallery." }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
